{
  "expo": {
    "name": "TOKI",
    "slug": "toki-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toknm.toki"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#667eea"
      },
      "package": "com.toknm.toki"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-av",
      "expo-speech"
    ]
  }
}